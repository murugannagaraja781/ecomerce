# ==============================================================================
# FLIPKART E-COMMERCE PLATFORM - ENVIRONMENT TEMPLATE
# Copy to environment.php or load via your secret management pipeline
# ==============================================================================

APP_ENV=production
APP_DEBUG=false
APP_NAME="Flipkart Shopping Platform"
APP_URL=http://localhost/ecommerce_api

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=flipkartdb
DB_USER=flipkart_user
DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD
DB_CHARSET=utf8mb4

# Security & JWT Tokens
# Minimum 32-character high-entropy secret
JWT_SECRET=REPLACE_WITH_HIGH_ENTROPY_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_ACCESS_EXPIRY=604800
JWT_REFRESH_EXPIRY=2592000

# Razorpay Production / Staging Credentials
RAZORPAY_KEY_ID=rzp_live_REPLACE_WITH_REAL_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_REAL_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_REAL_WEBHOOK_SECRET

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1,http://localhost:3000,http://localhost:8080"
